    <property>
      <code>/* The Administration adds a "Customize &lt;page&gt;:" heading above each page contributing to the section, except the
   first one. The Administration means to hide it, but its script looks for h1 headings while these are h2 (XWIKI-20104:
   Improve the display of Administration sections coming from different pages). Hide it, as XWiki's own WYSIWYG section
   does, since each contribution displays its own heading. */
#admin-page-content &gt; h2.wikigeneratedheader {
  display: none;
}

/* The violations of a page, grouped by rule, to mark as false positives. */
.docapp-violation-groups {
  margin-top: 1.5em;
}

.docapp-violation-group {
  margin-bottom: 1.5em;
  padding-bottom: 1em;
  border-bottom: 1px solid #ddd;
}

.docapp-violation-group-pages {
  margin-bottom: .5em;
}

.docapp-mark-false-positives .form-control {
  margin: .5em 0;
}</code>
