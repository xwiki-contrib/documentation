  <content>{{velocity}}
## The Administration adds a "Customize &lt;page&gt;:" heading above each page contributing to a section, except the first
## one, which this page's stylesheet hides (as XWiki's own WYSIWYG section does). So the page displays its own heading.
#set ($discard = $xwiki.ssx.use('DocApp.Code.CheckAllPagesAdministration'))##
== $services.rendering.escape($services.localization.render('docapp.checkAllPages.heading'), 'xwiki/2.1') ==

## Displayed in the "Documentation" section of the wiki Administration, so only to the wiki administrators. The script
## service also checks that the current user is one, since checking all pages saves each page whose violations changed.
#set ($sectionURL = $xwiki.getURL('XWiki.XWikiPreferences', 'admin', 'editor=globaladmin&amp;section=documentation'))##
#if ($request.method == 'POST' &amp;&amp; $services.csrf.isTokenValid($request.form_token))##
  #if ($request.checkAllPagesAction == 'start')##
    #set ($discard = $services.documentation.checkAllPages())##
  #elseif ($request.checkAllPagesAction == 'cancel')##
    #set ($discard = $services.documentation.cancelCheckAllPages())##
  #elseif ($request.checkAllPagesAction == 'markFalsePositives' &amp;&amp; "$!request.falsePositivesPage" != '')##
    ## The page picker submits the reference of the page, relative to the current page.
    #set ($markedCount = $services.documentation.markFalsePositives($request.check, $request.message,
      $services.model.resolveDocument($request.falsePositivesPage), $request.reason))##
    ## Display the remaining violations of the page, and how many have been marked.
    #set ($sectionURL = "${sectionURL}&amp;falsePositivesPage=$escapetool.url($request.falsePositivesPage)&amp;markedFalsePositives=$!markedCount")##
  #end##
  ## Redirect so that reloading the page doesn't post the action again.
  $response.sendRedirect($sectionURL)
  #stop##
#end##
#set ($checkAllPagesStatus = $services.documentation.checkAllPagesStatus)##
#set ($checkAllPagesRunning = $checkAllPagesStatus &amp;&amp; $checkAllPagesStatus.state != 'FINISHED')##
{{html clean="false"}}
## Loaded inside the HTML macro, where the whitespace output by the template doesn't produce empty lines.
#template('job_macros.vm')
&lt;form class="docapp-check-all-pages" method="post" action="$escapetool.xml($sectionURL)"&gt;
  &lt;p class="xHint"&gt;$escapetool.xml($services.localization.render('docapp.checkAllPages.hint'))&lt;/p&gt;
  &lt;input type="hidden" name="form_token" value="$!escapetool.xml($services.csrf.token)"/&gt;
  #if ($checkAllPagesRunning)
    &lt;button type="submit" name="checkAllPagesAction" value="cancel" class="btn btn-default"&gt;
      $escapetool.xml($services.localization.render('docapp.checkAllPages.cancel'))
    &lt;/button&gt;
  #else
    &lt;button type="submit" name="checkAllPagesAction" value="start" class="btn btn-primary"&gt;
      $escapetool.xml($services.localization.render('docapp.checkAllPages.start'))
    &lt;/button&gt;
  #end
&lt;/form&gt;
#if ($checkAllPagesStatus)
  #set ($jobStatusURL = $doc.getURL('get', $escapetool.url({
    'xpage': 'job_status_json',
    'outputSyntax': 'plain',
    'jobId': $checkAllPagesStatus.request.id,
    'translationPrefix': 'docapp.checkAllPages'
  })))
  &lt;div class="xcontent job-status docapp-check-all-pages-status" data-url="$escapetool.xml($jobStatusURL)"&gt;
    #if ($checkAllPagesRunning)
      ## Refreshes the progress bar and, once done, replaces it with the finish message.
      #set ($discard = $xwiki.jsfx.use('uicomponents/job/job.js'))
      #displayJobProgressBar($checkAllPagesStatus)
    #else
      #jobFinishedMessage($checkAllPagesStatus, 'docapp.checkAllPages', 'docapp.checkAllPages.lastRun.success')
      &lt;p class="docapp-check-all-pages-summary"&gt;$escapetool.xml($services.localization.render(
        'docapp.checkAllPages.summary', [$checkAllPagesStatus.checkedCount, $checkAllPagesStatus.updatedCount,
        $checkAllPagesStatus.failedCount]))&lt;/p&gt;
    #end
    #displayJobStatusLog($checkAllPagesStatus, true)
  &lt;/div&gt;
#end
{{/html}}

== $services.rendering.escape($services.localization.render('docapp.markFalsePositives.heading'), 'xwiki/2.1') ==

{{html clean="false"}}
#if ("$!request.markedFalsePositives" != '')
  &lt;div class="docapp-mark-false-positives-done"&gt;
    #success($escapetool.xml($services.localization.render('docapp.markFalsePositives.done',
      [$request.markedFalsePositives])))
  &lt;/div&gt;
#end
## First pick the page whose violations to list, along with the violations of the pages located under it.
&lt;form class="xform docapp-false-positives-page" method="get"
    action="$escapetool.xml($xwiki.getURL('XWiki.XWikiPreferences', 'admin'))"&gt;
  &lt;p class="xHint"&gt;$escapetool.xml($services.localization.render('docapp.markFalsePositives.hint'))&lt;/p&gt;
  &lt;input type="hidden" name="editor" value="globaladmin"/&gt;
  &lt;input type="hidden" name="section" value="documentation"/&gt;
  &lt;dl&gt;
    &lt;dt&gt;
      &lt;label for="docappFalsePositivesPage"&gt;$escapetool.xml($services.localization.render(
        'docapp.markFalsePositives.page'))&lt;/label&gt;
      &lt;span class="xHint"&gt;$escapetool.xml($services.localization.render('docapp.markFalsePositives.page.hint'))&lt;/span&gt;
    &lt;/dt&gt;
    &lt;dd&gt;
      #pagePicker({
        'id': 'docappFalsePositivesPage',
        'name': 'falsePositivesPage',
        'required': 'required',
        'value': "$!request.falsePositivesPage"
      })
    &lt;/dd&gt;
  &lt;/dl&gt;
  &lt;button type="submit" class="btn btn-default"&gt;$escapetool.xml($services.localization.render(
    'docapp.markFalsePositives.show'))&lt;/button&gt;
&lt;/form&gt;
## Then mark the violations of a rule at once.
#if ("$!request.falsePositivesPage" != '')
  #set ($falsePositivesPageReference = $services.model.resolveDocument($request.falsePositivesPage))
  #set ($violationGroups = $services.documentation.getViolationGroups($falsePositivesPageReference))
  &lt;div class="docapp-violation-groups"&gt;
  #if ($violationGroups.isEmpty())
    #info($escapetool.xml($services.localization.render('docapp.markFalsePositives.none',
      [$xwiki.getDocument($falsePositivesPageReference).plainTitle])))
  #end
  #foreach ($violationGroup in $violationGroups)
    #set ($groupId = "docappViolationGroup$foreach.count")
    &lt;div class="docapp-violation-group"&gt;
      &lt;p class="docapp-violation-group-message"&gt;
        #if ($violationGroup.severity == 'Error')
          #inlineError($escapetool.xml($violationGroup.message))
        #else
          #inlineWarning($escapetool.xml($violationGroup.message))
        #end
      &lt;/p&gt;
      &lt;p class="xHint"&gt;$escapetool.xml($services.localization.render('docapp.markFalsePositives.group.count',
        [$violationGroup.violationCount, $violationGroup.pages.size()]))&lt;/p&gt;
      ## The first pages are listed, the others are folded.
      &lt;ul class="docapp-violation-group-pages"&gt;
        #foreach ($violationPage in $violationGroup.pages)
          #if ($foreach.count == 6)
            &lt;/ul&gt;
            &lt;a role="button" class="docapp-violation-group-toggle" data-toggle="collapse" href="#${groupId}Pages"
                aria-expanded="false" aria-controls="${groupId}Pages"&gt;
              $escapetool.xml($services.localization.render('docapp.markFalsePositives.group.more',
                [$mathtool.sub($violationGroup.pages.size(), 5)]))
            &lt;/a&gt;
            &lt;ul id="${groupId}Pages" class="docapp-violation-group-pages collapse"&gt;
          #end
          &lt;li&gt;&lt;a href="$escapetool.xml($xwiki.getURL($violationPage))"&gt;$escapetool.xml(
            $xwiki.getDocument($violationPage).plainTitle)&lt;/a&gt;&lt;/li&gt;
        #end
      &lt;/ul&gt;
      &lt;form class="docapp-mark-false-positives" method="post"
          action="$escapetool.xml($xwiki.getURL('XWiki.XWikiPreferences', 'admin', 'editor=globaladmin&amp;section=documentation'))"&gt;
        &lt;input type="hidden" name="form_token" value="$!escapetool.xml($services.csrf.token)"/&gt;
        &lt;input type="hidden" name="falsePositivesPage" value="$escapetool.xml($request.falsePositivesPage)"/&gt;
        &lt;input type="hidden" name="check" value="$escapetool.xml($violationGroup.check)"/&gt;
        &lt;input type="hidden" name="message" value="$escapetool.xml($violationGroup.message)"/&gt;
        &lt;label for="${groupId}Reason"&gt;$escapetool.xml($services.localization.render(
          'docapp.ui.review.falsePositive.reason'))&lt;/label&gt;
        &lt;input type="text" id="${groupId}Reason" name="reason" class="form-control input-sm"/&gt;
        &lt;button type="submit" name="checkAllPagesAction" value="markFalsePositives" class="btn btn-primary btn-sm"&gt;
          $escapetool.xml($services.localization.render('docapp.markFalsePositives.submit',
            [$violationGroup.violationCount]))
        &lt;/button&gt;
      &lt;/form&gt;
    &lt;/div&gt;
  #end
  &lt;/div&gt;
#end
{{/html}}
{{/velocity}}</content>
