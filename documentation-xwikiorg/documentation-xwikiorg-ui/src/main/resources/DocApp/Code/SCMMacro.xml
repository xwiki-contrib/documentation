#set ($path = $path.replaceAll('^/+', ''))
#set ($raw = false)
#if ("$!wikimacro.parameters.raw" == 'true')
  #set ($raw = true)
#end
## A branch or a path points inside a repository, so it needs a project, and a path also needs a branch.
#if ($project == '' &amp;&amp; ($branch != '' || $path != ''))
  #set ($project = 'xwiki-platform')
#end
#if ($branch == '' &amp;&amp; $path != '')
  #set ($branch = 'master')
#end
#if ($raw)
  #set ($url = "https://raw.githubusercontent.com/$user")
#else
  #set ($url = "https://github.com/$user")
#end
#if ($project != '')
  #set ($url = "$url/$project")
#end
#if ($branch != '')
  #if ($raw)
    #set ($url = "$url/$branch")
  #else
    ## GitHub redirects "tree" to "blob" when the path is a file, so "tree" works for both files and directories.
    #set ($url = "$url/tree/$branch")
  #end
#end
#if ($path != '')
  #set ($url = "$url/$path")
#end
## Escape the sequences that would end the link reference early.
#set ($reference = $url.replace('~', '~~').replace('&gt;&gt;', '~&gt;~&gt;').replace('||', '~|~|').replace(']]', '~]~]'))
#if ("$!wikimacro.content" != '')
[[$wikimacro.content&gt;&gt;$reference]]##
#else
[[$reference]]##
#end
{{/velocity}}</code>
