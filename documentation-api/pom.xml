<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.xwiki.contrib.documentation</groupId>
    <artifactId>documentation</artifactId>
    <version>1.16-SNAPSHOT</version>
  </parent>
  <artifactId>documentation-api</artifactId>
  <name>Documentation Application - API</name>
  <packaging>jar</packaging>
  <description>API to validate documentation pages</description>
  <properties>
    <xwiki.jacoco.instructionRatio>0.95</xwiki.jacoco.instructionRatio>
    <!-- Name to display by the Extension Manager -->
    <xwiki.extension.name>Documentation Application API</xwiki.extension.name>
    <!-- The extension's category -->
    <xwiki.extension.category>api</xwiki.extension.category>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.xwiki.platform</groupId>
      <artifactId>xwiki-platform-index-api</artifactId>
      <version>${platform.version}</version>
    </dependency>
    <dependency>
      <groupId>org.xwiki.platform</groupId>
      <artifactId>xwiki-platform-bridge</artifactId>
      <version>${platform.version}</version>
    </dependency>
    <dependency>
      <groupId>org.xwiki.platform</groupId>
      <artifactId>xwiki-platform-oldcore</artifactId>
      <version>${platform.version}</version>
    </dependency>
    <!-- Provides the MacroRefactoring role implemented to keep the image macro's reference parameter in sync. -->
    <dependency>
      <groupId>org.xwiki.platform</groupId>
      <artifactId>xwiki-platform-rendering-xwiki</artifactId>
      <version>${platform.version}</version>
    </dependency>
    <!-- Runs the analysis of all documentation pages in the background. -->
    <dependency>
      <groupId>org.xwiki.commons</groupId>
      <artifactId>xwiki-commons-job-api</artifactId>
      <version>${commons.version}</version>
    </dependency>
    <!-- Restricts the analysis of all documentation pages to wiki administrators. -->
    <dependency>
      <groupId>org.xwiki.platform</groupId>
      <artifactId>xwiki-platform-security-authorization-api</artifactId>
      <version>${platform.version}</version>
    </dependency>
    <!-- Test Dependencies -->
    <dependency>
      <groupId>org.xwiki.platform</groupId>
      <artifactId>xwiki-platform-test-oldcore</artifactId>
      <version>${platform.version}</version>
      <type>pom</type>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.revapi</groupId>
        <artifactId>revapi-maven-plugin</artifactId>
        <configuration>
          <analysisConfiguration>
            <revapi.differences>
              <differences>
                <item>
                  <ignore>true</ignore>
                  <code>java.method.returnTypeChanged</code>
                  <old>method void org.xwiki.contrib.documentation.DocumentationManager::analyse(com.xpn.xwiki.doc.XWikiDocument) throws org.xwiki.index.IndexException</old>
                  <new>method boolean org.xwiki.contrib.documentation.DocumentationManager::analyse(com.xpn.xwiki.doc.XWikiDocument) throws org.xwiki.index.IndexException</new>
                  <justification>analyse() reports whether the violations changed, so that the analysis of all documentation pages can tell how many pages it updated. Callers ignoring the result keep working once recompiled.</justification>
                </item>
                <item>
                  <ignore>true</ignore>
                  <code>java.method.returnTypeChanged</code>
                  <old>method void org.xwiki.contrib.documentation.script.DocumentationScriptService::analyse(com.xpn.xwiki.doc.XWikiDocument) throws org.xwiki.index.IndexException</old>
                  <new>method boolean org.xwiki.contrib.documentation.script.DocumentationScriptService::analyse(com.xpn.xwiki.doc.XWikiDocument) throws org.xwiki.index.IndexException</new>
                  <justification>analyse() reports whether the violations changed, so that the analysis of all documentation pages can tell how many pages it updated. Callers ignoring the result keep working once recompiled.</justification>
                </item>
              </differences>
            </revapi.differences>
          </analysisConfiguration>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
